---
// Small spot illustrations, one per project. Shapes marked "art-move" animate on card hover.
interface Props {
  name: 'coins' | 'taxi' | 'trolley' | 'megaphone' | 'seed' | 'heart' | 'pages';
}
const { name } = Astro.props;
---

<svg class="art" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
  {
    name === 'coins' && (
      <g>
        <ellipse cx="46" cy="92" rx="30" ry="10" />
        <ellipse cx="46" cy="78" rx="30" ry="10" />
        <ellipse cx="46" cy="64" rx="30" ry="10" />
        <g class="art-move">
          <circle cx="84" cy="40" r="22" />
          <path class="art-line" d="M76 31h16M76 38h16M79 31c9 0 9 12 0 12l10 10" />
        </g>
      </g>
    )
  }
  {
    name === 'taxi' && (
      <g>
        <path class="art-line art-dash" d="M6 100h108" />
        <g class="art-move">
          <rect class="art-paper" x="52" y="26" width="18" height="10" rx="2" />
          <path d="M20 78V62l12-22h48l14 22h6a6 6 0 0 1 6 6v10z" />
          <path class="art-paper" d="M38 46h18v14H31zM62 46h15l9 14H62z" />
          <circle class="art-paper" cx="38" cy="80" r="10" />
          <circle class="art-paper" cx="86" cy="80" r="10" />
        </g>
      </g>
    )
  }
  {
    name === 'trolley' && (
      <g>
        <path class="art-line" d="M10 26h14l6 16" />
        <path d="M30 42h76l-10 34H40z" />
        <path class="art-line" d="M50 42l4 34M70 42v34M90 42l-4 34M36 59h66" />
        <circle class="art-paper" cx="48" cy="94" r="8" />
        <circle class="art-paper" cx="88" cy="94" r="8" />
        <g class="art-move">
          <circle class="art-paper" cx="58" cy="26" r="9" />
          <rect class="art-paper" x="74" y="14" width="16" height="20" rx="3" />
        </g>
      </g>
    )
  }
  {
    name === 'megaphone' && (
      <g>
        <path d="M22 50h18l40-22v64L40 70H22z" />
        <path class="art-paper" d="M30 70h14l4 26H36z" />
        <g class="art-move">
          <path class="art-line" d="M92 44c6 8 6 24 0 32M102 34c11 14 11 38 0 52" />
        </g>
      </g>
    )
  }
  {
    name === 'seed' && (
      <g>
        <path class="art-line" d="M52 112c-4-22 2-36 8-48" />
        <circle cx="60" cy="48" r="20" />
        <path class="art-line" d="M60 20v-8M40 28l-6-6M80 28l6-6M32 48h-8M88 48h8M40 68l-6 6M80 68l6 6" />
        <g class="art-move">
          <path class="art-line" d="M98 22l8-8M102 12h6v6M88 8l4-6" />
        </g>
      </g>
    )
  }
  {
    name === 'heart' && (
      <g>
        <path d="M60 100C22 74 12 54 20 38c8-16 30-16 40 0 10-16 32-16 40 0 8 16-2 36-40 62z" />
        <path class="art-line art-move" d="M22 60h22l8-16 12 30 8-14h26" />
      </g>
    )
  }
  {
    name === 'pages' && (
      <g>
        <rect class="art-paper" x="18" y="24" width="44" height="58" rx="4" transform="rotate(-8 40 53)" />
        <rect class="art-paper" x="28" y="20" width="44" height="58" rx="4" />
        <path class="art-line" d="M36 34h28M36 44h28M36 54h18" />
        <g class="art-move">
          <rect x="62" y="62" width="44" height="40" rx="4" />
          <path class="art-line" d="M62 76h44M62 89h44M77 62v40M92 62v40" />
        </g>
      </g>
    )
  }
</svg>
