---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/bricolage-grotesque/index.css';
import '@fontsource-variable/source-serif-4/index.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { person } from '../data/content';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const links = [
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Say hi' },
];
---

<!doctype html>
<html lang="en" data-theme="light" data-lens="all">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <ClientRouter />
    <script is:inline>
      // Applies the saved theme and role lens before paint, and again after each page transition,
      // because a transition replaces the <html> attributes with the new page's defaults.
      (function () {
        var lenses = ['all', 'analytics', 'science', 'engineering', 'ai'];
        function read(store, key) {
          try {
            return store.getItem(key);
          } catch (e) {
            return null;
          }
        }
        function apply() {
          var root = document.documentElement;
          root.dataset.theme = read(localStorage, 'theme') === 'dark' ? 'dark' : 'light';
          var lens = new URLSearchParams(location.search).get('lens') || read(sessionStorage, 'lens');
          root.dataset.lens = lenses.indexOf(lens) >= 0 ? lens : 'all';
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <a class="nav-name" href="/">megha<span>.</span></a>
      <nav aria-label="Main">
        {
          links.map((link) => (
            <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
      {person.resumeUrl && <a class="nav-resume" href={person.resumeUrl} download>Resume</a>}
      <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false">Dark</button>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer wrap">
      <p>
        <a href={`mailto:${person.email}`}>{person.email}</a>
        <a href={person.linkedin} rel="noopener">LinkedIn</a>
        <a href={person.github} rel="noopener">GitHub</a>
        {person.resumeUrl && <a href={person.resumeUrl} download>Resume (PDF)</a>}
      </p>
      <p>© {new Date().getFullYear()} {person.name}. The charts here are drawn from each project's own data.</p>
    </footer>

    <script>
      import '../scripts/ui.ts';
    </script>
  </body>
</html>
